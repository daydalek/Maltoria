--- a/src/NativeImpl/LunaHook/LunaHook/engines/python/python.cpp
+++ b/src/NativeImpl/LunaHook/LunaHook/engines/python/python.cpp
@@ -1,4 +1,33 @@
 #include "python.h"
 #include <dwrite.h>
+#if defined(__has_include) && __has_include(<atlbase.h>)
 #include <atlbase.h>
+#else
+// Maltoria: minimal CComPtr fallback so cross-compilation with xwin does not require ATL.
+template <class T>
+struct CComPtr
+{
+    T *p = nullptr;
+    CComPtr() = default;
+    ~CComPtr()
+    {
+        if (p)
+            p->Release();
+    }
+    CComPtr(const CComPtr &) = delete;
+    CComPtr &operator=(const CComPtr &) = delete;
+    T **operator&() { return &p; }
+    T *operator->() const { return p; }
+    void Attach(T *ptr)
+    {
+        if (p)
+            p->Release();
+        p = ptr;
+    }
+    template <class Q>
+    HRESULT QueryInterface(Q **pp) const
+    {
+        return p ? p->QueryInterface(__uuidof(Q), reinterpret_cast<void **>(pp)) : E_POINTER;
+    }
+};
+#endif
